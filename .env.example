# Django Environment (development or production)
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://yourdomain.com
PORT=8000

# PostgreSQL Database (Used by docker-compose)
POSTGRES_DB=fy_attendance
POSTGRES_USER=fy_user
POSTGRES_PASSWORD=replace-with-a-secure-db-password

# Caching & Celery (Set by docker-compose, or configure manually)
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Mnotify Bulk SMS Gateway
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=CHURCH
MNOTIFY_API_URL=https://api.mnotify.com/api/
